<?xml version="1.0" encoding="utf-8"?>
<!--
    Flavor-specific manifest overlay for the 'gapp' flavor.
    Spoofs com.google.android.googlequicksearchbox (Google Search / Google App).
    Inspired by: https://github.com/SolidEva/Gapp-Package-Spoof

    This flavor is intentionally standalone:
    - No Google Services Framework (GSF) provider
    - No microg dependency
    - No photosonly (Google Photos preview) activity
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        android:forceQueryable="true" ensures this package is always visible
        to other apps querying the package manager, even on Android 11+
        where package visibility is restricted.
    -->
    <application
        android:forceQueryable="true"
        tools:replace="android:forceQueryable">

        <!-- Remove GSF provider: gapp does not spoof Google Services Framework -->
        <provider
            android:name="de.lukaspieper.gcam.GServicesProvider"
            android:authorities="com.google.android.gsf.gservices"
            tools:node="remove" />

        <!-- Remove preview redirect activity: gapp does not depend on photosonly behavior -->
        <activity
            android:name="de.lukaspieper.gcam.PreviewRedirectActivity"
            tools:node="remove" />

    </application>

</manifest>
